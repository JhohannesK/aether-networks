# Optional. Empty = mock hunters, mock recordings, Simulated settlement.
SOLARI_API_KEY=

# Optional. Default https://api.getsolari.com
SOLARI_BASE_URL=

# Optional. Hierarchical agent keypairs. Empty = local-dev derivation (never commit a real seed).
AETHER_MASTER_SEED=

# Optional. Default https://api.devnet.solana.com
SOLANA_RPC_URL=

# Optional. Default ./data/aether.db
AETHER_DB_PATH=

# Optional. Solari residential proxy country code. Default us
AETHER_PROXY_COUNTRY=
